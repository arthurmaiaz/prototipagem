# Modelo da assinatura de release.
#
# Copie para keystore.properties (que está no .gitignore) e preencha.
# Sem o keystore.properties, o build release é assinado com a chave de debug.
#
# Para criar um keystore:
#   keytool -genkeypair -v -keystore ~/.android/keystores/brunifor-cct-release.jks \
#     -alias brunifor-cct -keyalg RSA -keysize 2048 -validity 10000
#
# Guarde o .jks e as senhas: sem eles, versões novas do app não instalam por cima
# das antigas (o Android exige a mesma chave).
storeFile=/caminho/para/brunifor-cct-release.jks
storePassword=COLOQUE_A_SENHA_DO_KEYSTORE
keyAlias=brunifor-cct
keyPassword=COLOQUE_A_SENHA_DA_CHAVE
