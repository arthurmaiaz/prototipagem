<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.NFC" />

    <!-- API REST do NFC (ServicoApiNfc): serviço em primeiro plano com notificação. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Opcional: o app instala em aparelho sem NFC e usa o QR Code. -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!-- Opcional: o leitor biométrico (Hamster DX) entra pelo USB OTG.
         O SDK da Nitgen declara como obrigatório; o tools:replace mantém opcional. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false"
        tools:replace="android:required" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="br.unifor.cct"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bruniforcct">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="br.unifor.cct"
            android:theme="@style/Theme.Bruniforcct"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.TesteBiometriaActivity"
            android:exported="true"
            android:label="Teste Biometria" />

        <activity
            android:name=".ui.TesteNfcActivity"
            android:exported="true"
            android:label="Teste NFC"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.TesteReservaActivity"
            android:exported="true"
            android:label="Teste Reserva" />

        <!-- Abre sozinha ao conectar o Hamster DX (já com a permissão USB). -->
        <activity
            android:name=".ui.TesteDigitalActivity"
            android:exported="true"
            android:label="Teste Digital"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <activity
            android:name=".ui.TesteCapturaActivity"
            android:exported="true"
            android:label="Teste Captura" />

        <activity
            android:name=".ui.TesteUsbActivity"
            android:exported="true"
            android:label="Teste USB" />

        <!-- Servidor HTTP da API do NFC (porta 8787). -->
        <service
            android:name=".rest.ServicoApiNfc"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Servidor HTTP local que atende pedidos de leitura de tag NFC vindos da rede." />
        </service>

        <activity
            android:name=".ui.PerfilActivity"
            android:exported="false"
            android:label="Meu Perfil" />

        <activity
            android:name=".ui.FaqActivity"
            android:exported="false"
            android:label="Perguntas Frequentes" />

        <activity
            android:name=".ui.AssistenteActivity"
            android:exported="false"
            android:label="Assistente Virtual" />
    </application>

</manifest>