<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/unifor_bg_surface"
    android:orientation="vertical">

    <!-- Cabeçalho Unifor -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnVoltarQr"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Voltar"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/qr_titulo"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="96dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/unifor_nome_universidade"
                android:src="@drawable/ic_unifor_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_header"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="CCT"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/qr_subtitulo"
            android:textColor="@color/unifor_header_subtext"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Principal com Câmera e Viewfinder -->
            <FrameLayout
                android:id="@+id/frameCameraContainer"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@drawable/bg_card_action"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:elevation="3dp">

                <!-- TextureView para exibição contínua do feed da câmera -->
                <TextureView
                    android:id="@+id/textureViewCamera"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Retículo do Viewfinder com animação de mira -->
                <FrameLayout
                    android:id="@+id/viewfinderReticle"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_qr_reticle">

                    <View
                        android:id="@+id/viewLaserScan"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_gravity="top"
                        android:background="#0091DA" />
                </FrameLayout>

                <!-- Estado 1: Inicializando Câmera -->
                <LinearLayout
                    android:id="@+id/layoutCarregando"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#D900223A"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:indeterminateTint="#0091DA" />

                    <TextView
                        android:id="@+id/tvCarregandoTexto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/qr_estado_inicializando"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Estado 2: Permissão Negada -->
                <LinearLayout
                    android:id="@+id/layoutPermissaoNegada"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F2FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="Permissão necessária"
                        android:src="@drawable/ic_warning_outline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/qr_permissao_titulo"
                        android:textColor="@color/unifor_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/qr_permissao_desc"
                        android:textColor="@color/unifor_text_secondary"
                        android:textSize="12.5sp" />

                    <Button
                        android:id="@+id/btnSolicitarPermissao"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_btn_primary"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/qr_permissao_btn"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Estado 3: Sem Câmera Disponível -->
                <LinearLayout
                    android:id="@+id/layoutSemCamera"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F2FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="Sem câmera"
                        android:src="@drawable/ic_warning_outline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Câmera Indisponível"
                        android:textColor="@color/unifor_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/qr_sem_camera"
                        android:textColor="@color/unifor_text_secondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

            </FrameLayout>

            <!-- Instruções visuais de leitura -->
            <TextView
                android:id="@+id/tvInstrucaoLeitura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/qr_instrucao"
                android:textColor="@color/unifor_text_secondary"
                android:textSize="13sp" />

            <!-- Card de Resultado (Exibido após uma leitura) -->
            <LinearLayout
                android:id="@+id/layoutResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_action"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <!-- Cabeçalho do Resultado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivIconeResultado"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Resultado"
                        android:src="@drawable/ic_badge_verified" />

                    <TextView
                        android:id="@+id/tvTituloResultado"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/qr_sucesso_titulo"
                        android:textColor="@color/unifor_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDescricaoResultado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/qr_sucesso_desc"
                    android:textColor="@color/unifor_text_secondary"
                    android:textSize="12.5sp" />

                <!-- Código Lido em Destaque -->
                <TextView
                    android:id="@+id/tvCodigoLido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="PAT-001"
                    android:textColor="@color/unifor_primary_brand"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Botões de Ação do Resultado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnLerNovamente"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="@string/qr_btn_ler_novamente"
                        android:textAllCaps="false"
                        android:textColor="@color/unifor_primary_brand"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnUsarReserva"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_primary"
                        android:text="@string/qr_btn_usar_reserva"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Ação de Digitação Manual de Código (Fallback/Testes) -->
            <Button
                android:id="@+id/btnDigitarManual"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="@string/qr_btn_digitar_manual"
                android:textAllCaps="false"
                android:textColor="@color/unifor_primary_brand"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <!-- Aviso Institucional de Integração com Vinícius -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_banner_notice"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="Alinhamento técnico"
                    android:src="@drawable/ic_info_outline" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/qr_vinicius_aviso"
                    android:textColor="@color/unifor_status_pending_text"
                    android:textSize="11.5sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
